# 敏感:密钥与部署私钥,严禁提交
.env
wink.pem

# 运行时数据(config/ 作为初始配置随库提交)
server/data/*
!server/data/config/
# 上一行放开了整个 config/,但令牌是首启生成的密钥,必须重新排除
server/data/config/portal_token.txt

# 构建与运行产物
*.egg-info/
deploy/*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node
node_modules/
web/dist/

# 其他
.DS_Store
*.db

# Claude Code (contains local paths and session state)
.claude/

# Editor artifacts
.trae-html-share-packages/

# Office 临时锁文件
~$*
