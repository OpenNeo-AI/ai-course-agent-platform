# ===== LLM 凭据(由 server/app/core/config.py 读取,严禁提交进仓库) =====
# 对话服务(OpenAI 兼容接口)
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_MODEL=doubao-seed-1-6-250615

# 向量化服务(可为独立接入点;留空则回退使用对话服务的 key/url)
ARK_EMBED_KEY=
ARK_EMBED_URL=
ARK_EMBED_MODEL=

# ===== 运行参数(可选,括号内为默认值) =====
CHUNK_SIZE=300        # 知识切块大小(字)
CHUNK_OVERLAP=40      # 切块重叠(字)
TOP_K=5               # 检索送入生成的片段数
HOST=0.0.0.0          # 服务监听地址
PORT=8000             # 服务监听端口

# ===== SaaS:认证 =====
JWT_SECRET=           # JWT 签名密钥;留空时由 portal token 派生(建议显式配置)

# ===== SaaS:阿里云短信(手机验证码注册/登录;不配置则演示模式,验证码随响应返回) =====
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=       # 短信签名
ALIYUN_SMS_TEMPLATE_CODE=   # 验证码模板(模板变量 ${code})
ALIYUN_SMS_REGION_ID=cn-hangzhou

# ===== SaaS:微信支付(Native 扫码,V2 API;不配置则该渠道不可用,下单自动回退模拟) =====
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=             # API 密钥(MD5 签名)
WECHAT_NOTIFY_URL=          # 支付回调公网地址,如 https://<域名>/api/billing/callback/wechat

# ===== SaaS:支付宝(电脑网站支付,RSA2;不配置则该渠道不可用) =====
ALIPAY_APP_ID=
ALIPAY_MERCHANT_PRIVATE_KEY=    # 应用私钥(PEM,可用字面 \n 转义)
ALIPAY_ALIPAY_PUBLIC_KEY=       # 支付宝公钥(PEM 或裸 base64)
ALIPAY_NOTIFY_URL=              # 异步通知公网地址,如 https://<域名>/api/billing/callback/alipay
