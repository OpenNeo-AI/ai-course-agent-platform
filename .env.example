# ===== LLM 凭据(由 server/app/core/config.py 读取,严禁提交进仓库) =====
# 对话服务(OpenAI 兼容接口)
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_MODEL=doubao-seed-1-6-250615

# 向量化服务(可为独立接入点;留空则回退使用对话服务的 key/url)
ARK_EMBED_KEY=
ARK_EMBED_URL=
ARK_EMBED_MODEL=

# ===== 运行参数(可选,括号内为默认值) =====
CHUNK_SIZE=300        # 知识切块大小(字)
CHUNK_OVERLAP=40      # 切块重叠(字)
TOP_K=5               # 检索送入生成的片段数
HOST=0.0.0.0          # 服务监听地址
PORT=8000             # 服务监听端口
