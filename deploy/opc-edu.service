# /etc/systemd/system/opc-edu.service
[Unit]
Description=OPC AI Course Advisor (FastAPI + MCP)
After=network.target

[Service]
WorkingDirectory=/opt/opc-edu/server
EnvironmentFile=/opt/opc-edu/.env
Environment="TZ=Asia/Shanghai"
ExecStart=/opt/opc-edu/server/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 7000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
